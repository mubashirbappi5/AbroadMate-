# ==============================================================================
# AbroadMate Production Environment Configuration Template
# All production secrets and environment variables required for deployment.
# NEVER commit real credentials (.env / .env.production) to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=3000
NEXT_PUBLIC_APP_URL="https://abroadmate.ai"
NEXT_PUBLIC_APP_NAME="AbroadMate"
NEXT_PUBLIC_DEFAULT_LOCALE="bn"

# ------------------------------------------------------------------------------
# 2. SUPABASE PRODUCTION DATABASE (POSTGRESQL & PGBOUNCER)
# ------------------------------------------------------------------------------
# Pooled Connection String (Port 6543 via PgBouncer for Next.js Serverless runtime)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=15"

# Direct Connection String (Port 5432 for Prisma Migrations & Worker persistent tasks)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 3. SUPABASE AUTHENTICATION & PRIVATE OBJECT STORAGE
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_STORAGE_BUCKET_DOCUMENTS="student-documents"

# ------------------------------------------------------------------------------
# 4. REDIS & BULLMQ ASYNC WORKER (UPSTASH / MANAGED REDIS)
# ------------------------------------------------------------------------------
REDIS_HOST="ap-southeast-1-redis.upstash.io"
REDIS_PORT=6379
REDIS_PASSWORD="your-secure-upstash-redis-password"
REDIS_TLS=true
# Or Unified Connection String:
# REDIS_URL="rediss://default:password@ap-southeast-1-redis.upstash.io:6379"

# ------------------------------------------------------------------------------
# 5. OPENAI API & AI GUARDRAILS
# ------------------------------------------------------------------------------
OPENAI_API_KEY="sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
OPENAI_MODEL="gpt-4o"
AI_MAX_TOKENS=2500
AI_RATE_LIMIT_MAX_REQUESTS=25
AI_RATE_LIMIT_WINDOW_MS=3600000

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL DELIVERY (RESEND / SENDGRID / POSTMARK)
# ------------------------------------------------------------------------------
EMAIL_FROM="AbroadMate <notifications@abroadmate.ai>"
SMTP_HOST="smtp.resend.com"
SMTP_PORT=587
SMTP_USER="resend"
SMTP_PASSWORD="re_xxxxxxxxxxxxxxxxxxxx"
# Alternative API Token:
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# ------------------------------------------------------------------------------
# 7. TELEGRAM PUSH ADAPTER (OPTIONAL STUDENT ALERTS)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
TELEGRAM_WEBHOOK_SECRET="your-telegram-webhook-secret"

# ------------------------------------------------------------------------------
# 8. SENTRY ERROR & PERFORMANCE MONITORING
# ------------------------------------------------------------------------------
SENTRY_DSN="https://xxxxxxxx@o000000.ingest.sentry.io/0000000"
NEXT_PUBLIC_SENTRY_DSN="https://xxxxxxxx@o000000.ingest.sentry.io/0000000"
SENTRY_AUTH_TOKEN="sntrys_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
SENTRY_ENVIRONMENT="production"
SENTRY_TRACES_SAMPLE_RATE="0.2"

# ------------------------------------------------------------------------------
# 9. BANGLADESH BANK EXCHANGE RATE SYNC (OPTIONAL)
# ------------------------------------------------------------------------------
EXCHANGE_RATE_API_KEY="" # Cached Bangladesh Bank fallback rates utilized if empty

# ==============================================================================
# AbroadMate - Environment Configuration Example
# ==============================================================================

# Application Configuration
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="AbroadMate"
NEXT_PUBLIC_DEFAULT_LOCALE="bn"

# PostgreSQL Database (Supabase / Local / Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/abroadmate?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/abroadmate?schema=public"

# Supabase Authentication & Storage
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET_DOCUMENTS="student-documents"

# Redis & BullMQ Worker
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_TLS=false

# OpenAI API (Provider Abstraction)
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-4o"
AI_MAX_TOKENS=2000

# Currency Conversion (Optional API, cached fallbacks used if empty)
EXCHANGE_RATE_API_KEY=""
